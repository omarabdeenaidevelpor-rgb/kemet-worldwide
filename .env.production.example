# =============================================================================
# KemetWorldwide — Production environment variables (Vercel → Settings → Environment Variables)
# =============================================================================

# PostgreSQL (Neon / Supabase). Use the POOLED connection string for the app:
DATABASE_URL="postgresql://USER:PASSWORD@HOST/kemetworldwide?sslmode=require&pgbouncer=true&connection_limit=1"
# NOTE: when running `prisma db push` from your machine, use the DIRECT (non-pooled) string.

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-32+-random-chars"
NEXTAUTH_URL="https://your-project.vercel.app"

# Persistent file storage for Documents (Vercel → Storage → Blob → Connect, auto-adds this)
BLOB_READ_WRITE_TOKEN=""
MAX_FILE_SIZE_MB="10"

# Optional — interactive tracking map
NEXT_PUBLIC_MAPBOX_TOKEN=""

# Login lockout policy
RATE_LIMIT_MAX_ATTEMPTS="5"
RATE_LIMIT_WINDOW_MINUTES="15"

# Used ONLY when running `npm run db:bootstrap` once to create the first admin
# ADMIN_EMAIL="you@company.com"
# ADMIN_PASSWORD="Strong#Password123"
# ADMIN_NAME="Your Name"
