# =============================================================================
# KemetWorldwide — Environment Variables
# Copy this file to .env.local and fill in the values for your environment.
# Never commit .env.local or any file containing real secrets to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# PostgreSQL connection string. Format:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kemetworldwide"

# -----------------------------------------------------------------------------
# NextAuth.js
# NEXTAUTH_SECRET: A random string of at least 32 characters used to sign
#   JWTs and encrypt session cookies. Generate with:
#   openssl rand -base64 32
# NEXTAUTH_URL: The canonical URL of your deployment (no trailing slash).
# -----------------------------------------------------------------------------
NEXTAUTH_SECRET="replace-with-a-random-string-of-at-least-32-characters"
NEXTAUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Mapbox (Interactive World Map)
# Obtain tokens from https://account.mapbox.com/
# MAPBOX_ACCESS_TOKEN: Server-side token (keep secret).
# NEXT_PUBLIC_MAPBOX_TOKEN: Public token exposed to the browser (prefix NEXT_PUBLIC_).
# -----------------------------------------------------------------------------
MAPBOX_ACCESS_TOKEN="pk.your_mapbox_secret_token_here"
NEXT_PUBLIC_MAPBOX_TOKEN="pk.your_mapbox_public_token_here"

# -----------------------------------------------------------------------------
# File Uploads
# FILE_UPLOAD_DIR: Absolute or relative path where uploaded files are stored.
#   Default: ./uploads (relative to project root)
# MAX_FILE_SIZE_MB: Maximum allowed upload size in megabytes.
#   Default: 10
# -----------------------------------------------------------------------------
FILE_UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB="10"

# -----------------------------------------------------------------------------
# Rate Limiting (Login / API)
# RATE_LIMIT_MAX_ATTEMPTS: Number of failed attempts before a lockout.
#   Default: 5
# RATE_LIMIT_WINDOW_MINUTES: Rolling window in minutes for counting attempts.
#   Default: 15
# -----------------------------------------------------------------------------
RATE_LIMIT_MAX_ATTEMPTS="5"
RATE_LIMIT_WINDOW_MINUTES="15"

# -----------------------------------------------------------------------------
# Node environment
# Values: development | test | production
# -----------------------------------------------------------------------------
NODE_ENV="development"
